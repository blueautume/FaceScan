    "No account is required. FaceScan does not upload scan data or provide cloud sync, and contains no advertising, analytics, or third-party tracking. The privacy agreement version and your filter preferences are also stored only on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account is required. FaceScan does not upload scan data or provide cloud sync, and contains no advertising, analytics, or third-party tracking. The privacy agreement version and your filter preferences are also stored only on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号。App 不上传扫描数据，不提供云同步，也不包含广告、分析统计或第三方追踪。协议版本与滤波参数偏好也仅保存在本机。"
          }
        }
      }
    },
