            "value": "Adaptive Smoothing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按起伏控制平滑"
          }
        }
      }
    },
    "Adjust filter settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust filter settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整滤波参数"
          }
        }
      }
    },
    "After each successful scan, FaceScan automatically saves an original point cloud on this device, including its positions, colors, and scan details. Filtering never overwrites the original. You can reopen or delete it in Scan History. Records are not automatically removed and are excluded from system backups. Deleting or reinstalling the app may erase them, so export any models you want to keep.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After each successful scan, FaceScan automatically saves an original point cloud on this device, including its positions, colors, and scan details. Filtering never overwrites the original. You can reopen or delete it in Scan History. Records are not automatically removed and are excluded from system backups. Deleting or reinstalling the app may erase them, so export any models you want to keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次扫描成功后，自动在本机保存一份原始点云，保留位置、颜色与扫描信息。滤波不会覆盖历史，可从历史列表重新打开或删除。历史不自动淘汰，排除系统备份；删除或重新安装 App 可能丢失记录，需要长期保留的模型请主动导出。"
          }
        }
      }
    },
    "Agree & Continue": {
      "extractionState": "manual",
