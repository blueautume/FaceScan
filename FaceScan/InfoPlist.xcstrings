      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FaceScan uses the front TrueDepth camera to create a 3D scan of your face. Scans are processed on your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前置原深感摄像头采集面部深度，在本机生成可旋转的三维面容。"
